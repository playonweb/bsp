    {
      "id": "contact-reveal",
      "name": "06 - Contact Card Reveal Functionality",
      "commands": [
        {
          "id": "1",
          "comment": "This test requires navigating to a specific user card page using the routing scheme",
          "command": "open",
          "target": "/1",
          "value": ""
        },
        {
          "id": "2",
          "command": "pause",
          "target": "1000",
          "value": ""
        },
        {
          "id": "3",
          "command": "assertElementPresent",
          "target": "css=[data-testid='card-email-reveal']",
          "value": ""
        },
        {
          "id": "4",
          "command": "assertText",
          "target": "css=[data-testid='card-email-reveal']",
          "value": "click to reveal email"
        },
        {
          "id": "5",
          "command": "click",
          "target": "css=[data-testid='card-email-reveal']",
          "value": ""
        },
        {
          "id": "6",
          "command": "pause",
          "target": "1500",
          "value": ""
        },
        {
          "id": "7",
          "command": "assertElementPresent",
          "target": "css=[data-testid='card-phone-reveal']",
          "value": ""
        },
        {
          "id": "8",
          "command": "assertText",
          "target": "css=[data-testid='card-phone-reveal']",
          "value": "click to reveal phone"
        },
        {
          "id": "9",
          "command": "click",
          "target": "css=[data-testid='card-phone-reveal']",
          "value": ""
        },
        {
          "id": "10",
          "command": "pause",
          "target": "1500",
          "value": ""
        }
      ]
    },
