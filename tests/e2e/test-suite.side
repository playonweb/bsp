{
  "id": "alink-e2e-tests",
  "version": "2.0",
  "name": "Alink E2E Test Suite",
  "url": "http://localhost:8080",
  "tests": [
    {
      "id": "homepage-load",
      "name": "01 - Homepage Load Test",
      "commands": [
        {
          "id": "1",
          "command": "open",
          "target": "/",
          "value": ""
        },
        {
          "id": "2",
          "command": "assertTitle",
          "target": "Alink",
          "value": ""
        },
        {
          "id": "3",
          "command": "assertElementPresent",
          "target": "css=[data-testid='header-nav']",
          "value": ""
        },
        {
          "id": "4",
          "command": "assertElementPresent",
          "target": "css=[data-testid='logo-link']",
          "value": ""
        },
        {
          "id": "5",
          "command": "assertElementPresent",
          "target": "css=[data-testid='github-link']",
          "value": ""
        },
        {
          "id": "6",
          "command": "assertElementPresent",
          "target": "css=[data-testid='docs-link']",
          "value": ""
        },
        {
          "id": "7",
          "command": "assertElementPresent",
          "target": "css=[data-testid='search-input']",
          "value": ""
        },
        {
          "id": "8",
          "command": "assertElementPresent",
          "target": "css=[data-testid='fab-add-contact']",
          "value": ""
        },
        {
          "id": "9",
          "command": "assertElementPresent",
          "target": "css=[data-testid='footer']",
          "value": ""
        }
      ]
    },
    {
      "id": "user-registration",
      "name": "02 - User Registration Flow",
      "commands": [
        {
          "id": "1",
          "command": "open",
          "target": "/",
          "value": ""
        },
        {
          "id": "2",
          "command": "click",
          "target": "css=[data-testid='fab-add-contact']",
          "value": ""
        },
        {
          "id": "3",
          "command": "pause",
          "target": "1000",
          "value": ""
        },
        {
          "id": "4",
          "command": "assertElementPresent",
          "target": "css=[data-testid='form-input-name']",
          "value": ""
        },
        {
          "id": "5",
          "command": "sendKeys",
          "target": "css=[data-testid='form-input-name']",
          "value": "Test User"
        },
        {
          "id": "6",
          "command": "sendKeys",
          "target": "css=[data-testid='form-input-email']",
          "value": "test.user@example.com"
        },
        {
          "id": "7",
          "command": "sendKeys",
          "target": "css=[data-testid='form-input-city']",
          "value": "San Francisco"
        },
        {
          "id": "8",
          "command": "sendKeys",
          "target": "css=[data-testid='form-input-phone']",
          "value": "+1 (555) 123-4567"
        },
        {
          "id": "9",
          "command": "click",
          "target": "css=[data-testid='form-terms-checkbox']",
          "value": ""
        },
        {
          "id": "9a",
          "command": "runScript",
          "target": "document.querySelector('[data-testid=\"form-submit-btn\"]').scrollIntoView({block: 'center', behavior: 'smooth'})",
          "value": ""
        },
        {
          "id": "9b",
          "command": "pause",
          "target": "500",
          "value": ""
        },
        {
          "id": "10",
          "command": "click",
          "target": "css=[data-testid='form-submit-btn']",
          "value": ""
        },
        {
          "id": "11",
          "command": "pause",
          "target": "2500",
          "value": ""
        }
      ]
    },
    {
