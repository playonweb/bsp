  "suites": [
    {
      "id": "full-suite",
      "name": "Full E2E Test Suite",
      "persistSession": true,
      "parallel": false,
      "timeout": 300,
      "tests": [
        "homepage-load",
        "user-registration",
        "search-functionality",
        "clear-search",
        "view-contact-modal",
        "contact-reveal",
        "navigation-tests",
        "form-modal-close"
      ]
    },
    {
      "id": "smoke-suite",
      "name": "Smoke Test Suite",
      "persistSession": true,
      "parallel": false,
      "timeout": 120,
      "tests": [
        "homepage-load",
        "navigation-tests"
      ]
    }
  ],
  "urls": [
    "http://localhost:8080"
  ],
  "plugins": []
}
