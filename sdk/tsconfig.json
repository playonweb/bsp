{
    "compilerOptions": {
        "target": "ESNext",
        "module": "ESNext",
        "moduleResolution": "node",
        "esModuleInterop": true,
        "strict": true,
        "outDir": "dist",
        "declaration": true,
        "sourceMap": true,
        "lib": [
            "ESNext",
            "DOM"
        ]
    },
    "include": [
        "dist/**/*.ts"
    ],
